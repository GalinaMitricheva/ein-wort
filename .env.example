# Copy to .env and fill in. The real .env is gitignored — never commit it.
#
# Mint this token once with:  claude setup-token
# It authenticates against your Claude subscription (see docs/architecture.md 7b).
ANTHROPIC_AUTH_TOKEN=REPLACE_WITH_TOKEN_FROM_claude_setup-token

# Do NOT add ANTHROPIC_API_KEY here. Even an empty value wins the SDK's
# credential-resolution slot and authenticates with an empty key, silently
# overriding the token above. If you need a key instead of the token, set it in
# your shell — and unset ANTHROPIC_AUTH_TOKEN, since the two together are rejected.

# PORT=3000
